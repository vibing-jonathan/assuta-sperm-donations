rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'jgabbayj@gmail.com',
          'robieis153@gmail.com'
        ];
    }

    match /donor-pages/{donorKey}/{fileName} {
      allow read: if isAdmin() && fileName == 'details.pdf';
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
