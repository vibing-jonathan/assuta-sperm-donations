rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'jgabbayj@gmail.com',
          'robieis153@gmail.com'
        ];
    }

    function isUserApp() {
      return request.auth != null && request.auth.token.userApp == true;
    }

    match /donor-pages/{donorKey}/{fileName} {
      allow read: if (isAdmin() || isUserApp()) && fileName == 'details.pdf';
      allow write: if false;
    }

    match /donor-profile-images/{donorId}/{fileName} {
      allow read: if (isAdmin() || isUserApp()) && fileName.matches('[a-f0-9]{64}\\.jpg');
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
